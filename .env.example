# Database (Use MongoDB Atlas free tier for cloud deployment)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/whatsapp-tickets?retryWrites=true&w=majority

# Google Gemini API (For AI customer support in WhatsApp)
GOOGLE_API_KEY=your_gemini_api_key

# Razorpay Credentials (Use Test mode keys for demo)
RAZORPAY_KEY=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_SECRET=your_razorpay_secret

# Security
JWT_SECRET=super_secret_jwt_key_change_me

# Optional (Defaults to 5000)
PORT=5000
